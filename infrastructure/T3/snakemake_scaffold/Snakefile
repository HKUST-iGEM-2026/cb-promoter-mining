# =====================================================================
# Promoter Mining — HPC4 pipeline (Task T3).  REAL commands.
#
# Every rule runs its REAL command (no echo/touch mocks). Phase A is produced by
# local_prep.smk (+ tss_prep.smk for T10) and consumed here as pre-staged inputs/.
#
# EXECUTION STATUS (2026-06) — what runs today vs what needs its script/data first:
#   LIVE (verified):  extract_bakta, collect_bakta_tsv, T7b(1,434 in-genus), T11, T12, T13, T14,
#                     T15(written 2026-06, validated on synthetic; first real run pending),
#                     PT3, PT4, PT5(GPU), PT6(needs a RegulonDB TSS table)
#   TEMPLATE w/ known defects (fix before running): PT1, T18, T19, T20, T21, T23, T24, T28
#   SCRIPT NOT YET WRITTEN (rule will fail until implemented): PT2, T16, T22, T25, T26, T27, T29, T30, T31, T32
# Rules below keep a `results/<task>.done` sentinel as the snakemake output (so the DAG
# order is preserved); the real command writes its real data under results/<task>/ and
# then touches the sentinel. T11-T14 instead declare their real .tsv as the output.
#
# Run:
#     snakemake -s local_prep.smk --cores 4                          # stage Phase A inputs/ first
#     snakemake -n --config bakta_dir=/path/to/bakta(.zip|dir)       # DRY-RUN: validate the whole DAG (the wiring test)
#     snakemake --cores 4 --config bakta_dir=/path/to/bakta          # run locally (executes real commands; stops at the first unwritten script)
#     snakemake --workflow-profile profiles/slurm                    # on HPC4 (GPU rules submit as SLURM jobs)
# =====================================================================

import os

configfile: "config/config.yaml"

# Repo root, resolved from the Snakefile location (portable local <-> HPC4).
REPO = os.path.abspath(os.path.join(workflow.basedir, "..", "..", ".."))

# T6 Bakta outputs. config[bakta_dir] is either a .zip (HPC4) or an already-extracted dir.
# Normalise to BAKTA = the root dir that directly contains the <genome>_genomic_output/ subdirs.
BAKTA_SRC = config["bakta_dir"]
if not os.path.isabs(BAKTA_SRC):
    BAKTA_SRC = os.path.join(REPO, BAKTA_SRC)  # repo-relative -> absolute (portable across clone locations)
if str(BAKTA_SRC).endswith(".zip"):
    BAKTA = "results/bakta/all_bakta_output"   # produced by rule extract_bakta
else:
    BAKTA = BAKTA_SRC                          # already-extracted dir (external input)

# GPU jobs add per-GPU billing on top of the profile's preempt hygiene.
GPU_EXTRA = "'--gpus-per-node=1 --requeue --signal=B:USR1@120'"

# ---- Phase A starting state (produced by local_prep.smk / tss_prep.smk, pre-staged) ----
REFDB         = "inputs/reference_promoters.parquet"      # T8  — RegulonDB (+DBTBS) normalised
LIT_PROM      = "inputs/literature_promoters.tsv"         # T9  — curated synthetic promoters
TSS_CALLS     = "inputs/tss_sites.gff3"                   # T10 — TSSpredator empirical TSS (HPC4)
PUBLISHED_TSS = "inputs/published_tss_promoters.parquet"  # T7b — in-genus published TSS positives -> T15
LIT_TRAIN     = "inputs/literature_promoters_train.parquet"  # T9-split (§7 b) — in-genus training positives -> T15

# The only true graph leaves (evaluation reports + final deliverable).
LEAVES = ["T23", "T24", "T25", "T32"]


rule all:
    input:
        expand("results/{t}.done", t=LEAVES),


# GPU-heavy tasks submit as SLURM jobs; everything listed here runs on the login/submit node.
localrules: all, extract_bakta, collect_bakta_tsv, pt2_ship_to_huggingface, pt3_metrics_cv_stack, pt4_calibration_fdr_harness, pt6_validate_lock_schema, t11_housekeeping_set, t12_operon_detection, t13_upstream_extraction, t14_negative_set, t15_cdhit_splits, t16_tokenisation, t17_finetune_recipe, t22_metrics_suite, t25_sigma_stratified, t26_calibration, t27_empirical_fdr, t29_ensemble_aggregation, t30_peak_calling, t31_motif_annotation, t32_final_output

