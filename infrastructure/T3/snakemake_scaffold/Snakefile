    input: ANNOTATIONS, "results/T11.done"
    output: "results/T12.done"
    shell: "echo '[T12] operon detection (mock)' && touch {output}"
    # real: python scripts/operon_detection.py {input} {output}   (intergenic gap + strand; contig-end exclusion)

rule t13_upstream_extraction:
    input: "results/T11.done", "results/T12.done"
    output: "results/T13.done"
    shell: "echo '[T13] upstream region extraction (mock)' && touch {output}"
    # real: python scripts/extract_upstream.py {input} {output}   (100-300 bp upstream; gffutils + samtools faidx; drop contig-end-truncated)

rule t14_negative_set:
    input: ANNOTATIONS, "results/T13.done"
    output: "results/T14.done"
    shell: "echo '[T14] four-class negatives incl. SRS (mock)' && touch {output}"
    # real: python scripts/make_negatives.py {input} {output}   (CDS / intergenic / 3' + SRS via ushuffle)

rule t15_cdhit_splits:
    input: REFDB, TSS_CALLS, "results/T13.done", "results/T14.done"
    output: "results/T15.done"
    shell: "echo '[T15] CD-HIT clustering + cluster-aware splits (mock)' && touch {output}"
    # real: python scripts/cdhit_splits.py {input} {output}   (cd-hit clustering + StratifiedGroupKFold; 80/10/10)

rule t16_tokenisation:
    input: "results/T15.done"
    output: "results/T16.done"
    shell: "echo '[T16] per-model tokenisation (mock)' && touch {output}"
    # real: python scripts/tokenise.py {input} {output}   (ProkBERT k-mer / NT BPE / CNN one-hot)


