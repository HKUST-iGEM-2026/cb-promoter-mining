# =====================================================================
# Promoter Mining — HPC4 pipeline (Task T3)
#
# This pipeline starts at Phase B. Phase A is produced beforehand and uploaded
# to HPC4 as the starting state (see context §3), consumed here as pre-staged
# files under inputs/:
#   - T5-T9 run LOCALLY, one-shot     -> local_prep.smk
#   - T10 (TSSpredator) runs on HPC4  -> tss_prep.smk
#
# REAL vs MOCK (2026-06): the dataset-construction steps with verified scripts
# run for REAL and produce real files:
#       collect_bakta_tsv, T11, T12, T13, T14
# Everything downstream of T14 (T15-T32) and the pre-tasks are still MOCK
# (echo + touch results/<task>.done); each carries an accurate `# real:` command
# pointing at the actual script + arguments to drop in when implemented.
#
# Run:
#     snakemake -s local_prep.smk --cores 4                        # stage Phase A inputs/ first
#     snakemake -n                                                 # DRY-RUN: validate the whole DAG
#     snakemake --cores 4 --config bakta_dir=/path/to/bakta_outputs  # run real Phase B locally
#     snakemake --workflow-profile profiles/slurm                  # on HPC4
# =====================================================================

import os

configfile: "config/config.yaml"

# Repo root, resolved from the Snakefile location (portable local <-> HPC4).
REPO = os.path.abspath(os.path.join(workflow.basedir, "..", "..", ".."))

# T6 Bakta outputs. config[bakta_dir] is either:
#   - a .zip (HPC4: all_bakta_output/<genome>_genomic_output/<genome>_genomic.{gff3,fna,tsv}), or
#   - an already-extracted directory (local dev) whose children are <genome>_genomic_output/.
# Normalise to BAKTA = the root dir that directly contains the <genome>_genomic_output/ subdirs.
BAKTA_SRC = config["bakta_dir"]
if str(BAKTA_SRC).endswith(".zip"):
    BAKTA = "results/bakta/all_bakta_output"   # produced by rule extract_bakta
else:
    BAKTA = BAKTA_SRC                          # already-extracted dir (external input)

# GPU jobs add per-GPU billing on top of the profile's preempt hygiene.
GPU_EXTRA = "'--gpus-per-node=1 --requeue --signal=B:USR1@120'"

# ---- Phase A starting state (produced locally / on HPC4, pre-staged) --------
# Small files uploaded before this pipeline runs; the cluster pipeline does not
# build them. (The bulky Bakta outputs are NOT staged this way — they are read
# directly from BAKTA above.)
REFDB         = "inputs/reference_promoters.parquet"      # T8  — RegulonDB (+DBTBS) normalised (local_prep)
LIT_PROM      = "inputs/literature_promoters.tsv"         # T9  — curated synthetic promoters (local_prep)
TSS_CALLS     = "inputs/tss_sites.gff3"                   # T10 — TSSpredator empirical TSS (tss_prep, HPC4)
PUBLISHED_TSS = "inputs/published_tss_promoters.parquet"  # T7b — in-genus published TSS positives (local_prep) -> T15

# The only true graph leaves (evaluation reports + final deliverable).
LEAVES = ["T23", "T24", "T25", "T32"]


rule all:
    input:
        expand("results/{t}.done", t=LEAVES),


# Only the GPU-heavy tasks are submitted as SLURM jobs. Everything listed here
# runs locally on the login/submit node instead (CPU/light). The cluster jobs
# (NOT listed) are: PT1, PT5, T18, T19, T20, T21, T23, T24, T28.
localrules: all, extract_bakta, collect_bakta_tsv, pt2_ship_to_huggingface, pt3_metrics_cv_stack, pt4_calibration_fdr_harness, pt6_validate_lock_schema, t11_housekeeping_set, t12_operon_detection, t13_upstream_extraction, t14_negative_set, t15_cdhit_splits, t16_tokenisation, t17_finetune_recipe, t22_metrics_suite, t25_sigma_stratified, t26_calibration, t27_empirical_fdr, t29_ensemble_aggregation, t30_peak_calling, t31_motif_annotation, t32_final_output

