    input: "results/T29.done"
    output: "results/T30.done"
    shell:
        "python {REPO}/mining-and-motif-annotation/peak-calling/peak_calling.py results/T29/ results/T30/ && touch {output}"
    # SCRIPT NOT YET WRITTEN (scipy.signal peak calling on the ensemble score track; emits candidates.fasta).

rule t31_motif_annotation:
    input: "results/T30.done"
    output: "results/T31.done"
    shell:
        # de-novo motifs with MEME, then scan with FIMO (MEME suite, bio env). Needs results/T30/candidates.fasta.
        "meme results/T30/candidates.fasta -oc results/T31/meme -dna -mod zoops -nmotifs 5 -minw 6 -maxw 35 && "
        "fimo --oc results/T31/fimo results/T31/meme/meme.txt results/T30/candidates.fasta && touch {output}"
    # -10/-35 + sigma motif annotation. (FIMO alone against a known sigma-motif DB is the short-on-time fallback.)

