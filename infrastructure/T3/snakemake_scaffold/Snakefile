# ---------------------------------------------------------------------
# Phase B — Dataset construction   *** WIRED FOR REAL (T11-T14) ***
#   Reads the Bakta outputs directly from BAKTA (config[bakta_dir]).
# ---------------------------------------------------------------------
rule extract_bakta:
    # HPC4 ships the Bakta outputs as a zip whose top folder is all_bakta_output/
    # (containing the 166 <genome>_genomic_output/ dirs; gff3/fna/tsv only, ~456 MB).
    # Only runs when config[bakta_dir] is a .zip; with an already-extracted dir, BAKTA
    # points straight at it and this rule is never requested. __MACOSX junk is excluded.
    input: BAKTA_SRC
    output: directory("results/bakta/all_bakta_output")
    shell:
        "rm -rf results/bakta && mkdir -p results/bakta && "
        "unzip -q -o {input} -x '__MACOSX/*' -d results/bakta && "
        "test -d {output}"

rule collect_bakta_tsv:
    # T11 wants a FLAT directory of Bakta *.tsv, but the real outputs are nested as
    # <BAKTA>/<g>_genomic_output/<g>_genomic.tsv  -> symlink them flat first.
    # Resolve BAKTA to an ABSOLUTE path so the symlinks are valid no matter where they
    # are read from (BAKTA is relative in the zip-extract case: results/bakta/all_bakta_output).
    input: BAKTA
    output: directory("results/bakta_tsv")
    shell:
        r"""
        mkdir -p {output}
        root=$(cd "{input}" && pwd)
        for d in "$root"/*_genomic_output; do
          s=$(basename "$d" _output)
          ln -sf "$d/$s.tsv" "{output}/$s.tsv"
        done
        """

rule t11_housekeeping_set:
    input: "results/bakta_tsv"
    output: "results/T11/housekeeping_genes.tsv"
    shell:
        "python {REPO}/dataset-construction/T11/define_housekeeping.py "
        "--tsv-dir {input} --out-dir results/T11"
    # also writes housekeeping_summary.tsv + per_genome_counts.tsv into results/T11/

rule t12_operon_detection:
    input:
        hk="results/T11/housekeeping_genes.tsv",
        bakta=BAKTA,
    output: "results/T12/operon_leaders.tsv"
    shell:
        "python {REPO}/dataset-construction/T12/operon_detection.py "
        "--hk-tsv {input.hk} --bakta-dir {input.bakta} --out-tsv {output} "
        "--max-dist {config[operon_max_dist_bp]} --window {config[upstream_window_bp]}"

rule t13_upstream_extraction:
    input:
        leaders="results/T12/operon_leaders.tsv",
        bakta=BAKTA,
    output: "results/T13/upstream_regions.tsv"           # the POSITIVE windows (NB §7: inferred positives)
    shell:
        "python {REPO}/dataset-construction/T13/upstream_extraction.py "
        "--leaders-tsv {input.leaders} --bakta-dir {input.bakta} --out-tsv {output} "
        "--window {config[upstream_window_bp]}"

rule t14_negative_set:
    input:
        upstream="results/T13/upstream_regions.tsv",
        bakta=BAKTA,
    output: "results/T14/negative_set.tsv"               # four-class negatives incl. SRS
    shell:
        "python {REPO}/dataset-construction/T14/negative_set_generation.py "
        "--upstream-tsv {input.upstream} --bakta-dir {input.bakta} --out-tsv {output} "
        "--window {config[upstream_window_bp]}"
    # NB: T14 has no --seed yet (unseeded random -> non-reproducible negatives); add one before locking (CLAUDE.md §6).

rule t15_cdhit_splits:
    input:
        refdb=REFDB,                                     # T8 cross-species positives
        published=PUBLISHED_TSS,                         # T7b in-genus positives
        tss=TSS_CALLS,                                   # T10 empirical TSS
        positives="results/T13/upstream_regions.tsv",    # T13 inferred positives
        negatives="results/T14/negative_set.tsv",        # T14 negatives
    output: "results/T15.done"
    shell: "echo '[T15] CD-HIT clustering + cluster-aware splits (mock)' && touch {output}"
    # real: python {REPO}/dataset-construction/T15/cdhit_splits.py \
    #         --positives {input.refdb} {input.published} {input.positives} --negatives {input.negatives} \
    #         --identity {config[cdhit_identity]} --seed {config[random_seed]} --out results/T15/
    #       (cd-hit clustering + StratifiedGroupKFold, 80/10/10; concatenates the positive tables — they must
    #        share a schema first. T15 script not yet written; resolve the §7 label-semantics decision before pooling.)

rule t16_tokenisation:
    input: "results/T15.done"
    output: "results/T16.done"
