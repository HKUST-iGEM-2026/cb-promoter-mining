# =====================================================================
# Promoter Mining — HPC4 pipeline scaffold (Task T3), MOCK
#
# This pipeline starts at Phase B. Phase A (data acquisition + curation,
# T5-T10) is done LOCALLY, one-shot, and its outputs are uploaded to HPC4
# as the starting state (see context §3). Those outputs are consumed here
# as the pre-staged files under inputs/ (defined below).
#
# To produce the starting state locally for a mock run:
#     snakemake -s local_prep.smk --cores 4      # creates inputs/
# Then run this pipeline:
#     snakemake --cores 4                        # local wiring test
#     snakemake --workflow-profile profiles/slurm  # on HPC4
#
# Every rule below is a placeholder (echo + touch). Replace the shell:
# line of your own rule with the real command when you implement it.
# =====================================================================

configfile: "config/config.yaml"

# GPU jobs add per-GPU billing on top of the profile's preempt hygiene.
GPU_EXTRA = "'--gpus-per-node=1 --requeue --signal=B:USR1@120'"

# ---- Phase A starting state (produced locally, uploaded to HPC4) -----
# These files must already exist before the pipeline runs. They are the
# outputs of the local Phase A step; the cluster pipeline does not build them.
ANNOTATIONS = "inputs/annotations.done"           # T6  — Bakta annotations
REFDB       = "inputs/refdb_parquet.done"         # T8  — RegulonDB + DBTBS, normalised
LIT_PROM    = "inputs/literature_promoters.tsv"   # T9  — curated synthetic promoters
TSS_CALLS   = "inputs/tss_calls.done"             # T10 — TSSpredator empirical TSS

# The only true graph leaves (evaluation reports + final deliverable).
LEAVES = ["T23", "T24", "T25", "T32"]


rule all:
    input:
        expand("results/{t}.done", t=LEAVES),


# Only the GPU-heavy tasks run on HPC4 (submitted as SLURM jobs). Every rule
# listed here runs locally on the login/submit node instead — see context
# §3/§8 ("HPC4 for necessary tasks only"). The 9 NOT listed are the cluster
# jobs: PT1, PT5, T18, T19, T20, T21, T23, T24, T28. To move a hybrid task
# (e.g. T15, T22, T29) onto the cluster, just remove it from this list.
localrules: all, t1_hpc4_access, t2_github_repo, t3_snakemake_slurm_scaffold, t4_conda_env, pt2_ship_to_huggingface, pt3_metrics_cv_stack, pt4_calibration_fdr_harness, pt6_validate_lock_schema, t11_housekeeping_set, t12_operon_detection, t13_upstream_extraction, t14_negative_set, t15_cdhit_splits, t16_tokenisation, t17_finetune_recipe, t22_metrics_suite, t25_sigma_stratified, t26_calibration, t27_empirical_fdr, t29_ensemble_aggregation, t30_peak_calling, t31_motif_annotation, t32_final_output

# ---------------------------------------------------------------------
# Pre-tasks (learning + reusable code)
# ---------------------------------------------------------------------
rule pt1_finetune_loop:
    output: "results/PT1.done"
    resources: slurm_extra=GPU_EXTRA, runtime=240
    shell: "echo '[PT1] fine-tune loop on RegulonDB/DBTBS (mock GPU)' && touch {output}"
    # real: python pre-tasks/PT1/prokbert_finetune.py

rule pt2_ship_to_huggingface:
    input: "results/PT1.done"
    output: "results/PT2.done"
    shell: "echo '[PT2] ship ProkBERT to HuggingFace (mock)' && touch {output}"
    # real: python pre-tasks/PT2/push_to_hub.py   (model.push_to_hub the checkpoint)

rule pt3_metrics_cv_stack:
    output: "results/PT3.done"
    shell: "echo '[PT3] metrics + CV stack on dummy classifier (mock)' && touch {output}"
    # real: python pre-tasks/PT3/metrics_cv.py

rule pt4_calibration_fdr_harness:
    input: "results/PT3.done"
    output: "results/PT4.done"
    shell: "echo '[PT4] calibration + FDR harness (mock)' && touch {output}"
    # real: python pre-tasks/PT4/calibration_fdr_harness.py   (reused by T26/T27)

rule pt5_sliding_window_ecoli:
    output: "results/PT5.done"
    resources: slurm_extra=GPU_EXTRA, runtime=240
    shell: "echo '[PT5] sliding-window inference on E. coli (mock GPU)' && touch {output}"
    # real: python pre-tasks/PT5/sliding_window_ecoli.py   (sanity-check vs RegulonDB)

rule pt6_validate_lock_schema:
    input: "results/PT5.done"
    output: "results/PT6.done"
    shell: "echo '[PT6] validate pipeline + lock output schema (mock)' && touch {output}"
    # real: python pre-tasks/PT6/validate_lock_schema.py   (validate PT5; lock schema)


# ---------------------------------------------------------------------
# Phase B — Dataset construction
#   (consumes the Phase A starting state: ANNOTATIONS, REFDB, TSS_CALLS)
# ---------------------------------------------------------------------
rule t11_housekeeping_set:
    input: ANNOTATIONS
    output: "results/T11.done"
    shell: "echo '[T11] housekeeping gene set (mock)' && touch {output}"
    # real: python scripts/housekeeping_set.py {input} {output}   (core/constitutive genes)

