# =====================================================================
# Promoter Mining — HPC4 data pipeline scaffold (Task T3), MOCK
#
# This contains only the actual data-processing steps: Phase B (dataset
# construction) -> C (training) -> D (evaluation) -> E (mining).
#
# NOT in here (on purpose):
#   - Infrastructure T1-T4 (HPC4 access, repo, this scaffold, conda env):
#     one-time setup / preconditions, not data steps.
#   - Pre-tasks PT1-PT6: learning + reusable-code prep. They produce code
#     and a locked output schema that downstream rules IMPORT, not files
#     the pipeline consumes — so they aren't pipeline rules.
#   - Phase A T5-T10 (acquisition + curation): done locally one-shot, see
#     local_prep.smk. Its outputs are the pre-staged inputs/ below.
# These are still real project tasks — they just live in the project plan,
# not in this automation.
#
# Each rule's `shell:` is a mock (echo + touch). The `# real:` comment under
# it is an example of the command to drop in when you implement that task.
# Keep the input:/output: filenames as-is so the DAG stays connected.
#
# Run (mock):
#   snakemake -s local_prep.smk --cores 4        # make inputs/ locally
#   snakemake --cores 4                          # local wiring test
#   snakemake --workflow-profile profiles/slurm  # on HPC4
# =====================================================================

configfile: "config/config.yaml"

# GPU jobs add per-GPU billing on top of the profile's preempt hygiene.
GPU_EXTRA = "'--gpus-per-node=1 --requeue --signal=B:USR1@120'"

# ---- Phase A starting state (produced locally, uploaded to HPC4) -----
ANNOTATIONS = "inputs/annotations.gff3"          # T6  — Bakta annotations
REFDB       = "inputs/reference_promoters.parquet"  # T8  — RegulonDB + DBTBS, normalised
LIT_PROM    = "inputs/literature_promoters.tsv"  # T9  — curated synthetic promoters
TSS_CALLS   = "inputs/tss_sites.gff3"            # T10 — TSSpredator empirical TSS

# Final targets = the four graph leaves (3 evaluation reports + deliverable).
rule all:
    input:
        "results/eval/cv_results.tsv",        # T23
        "results/eval/cross_species.tsv",     # T24
        "results/eval/sigma_stratified.tsv",  # T25
        "results/final_candidates.tsv",       # T32


# Only the GPU-heavy tasks run on HPC4 (submitted as SLURM jobs). Everything
# listed here runs locally on the login/submit node — see context §3/§8.
# The 7 NOT listed are the cluster jobs: T18, T19, T20, T21, T23, T24, T28.
localrules: all, t11_housekeeping_set, t12_operon_detection, t13_upstream_extraction, t14_negative_set, t15_cdhit_splits, t16_tokenisation, t17_finetune_recipe, t22_metrics_suite, t25_sigma_stratified, t26_calibration, t27_empirical_fdr, t29_ensemble_aggregation, t30_peak_calling, t31_motif_annotation, t32_final_output


# ---------------------------------------------------------------------
# Phase B — Dataset construction  (consumes Phase A inputs/)
# ---------------------------------------------------------------------
rule t11_housekeeping_set:
    input: ANNOTATIONS
    output: "results/housekeeping_genes.tsv"
    shell: "echo '[T11] housekeeping gene set (mock)' && touch {output}"
    # real: python scripts/select_housekeeping.py --annotations {input} -o {output}

rule t12_operon_detection:
    input: ANNOTATIONS, "results/housekeeping_genes.tsv"
    output: "results/operons.tsv"
    shell: "echo '[T12] operon detection (mock)' && touch {output}"
    # real: python scripts/detect_operons.py --annotations {input[0]} --contig-end-buffer 350 -o {output}

rule t13_upstream_extraction:
    input: "results/housekeeping_genes.tsv", "results/operons.tsv"
    output: "results/upstream_regions.fasta"
    shell: "echo '[T13] upstream region extraction (mock)' && touch {output}"
    # real: python scripts/extract_upstream.py --operons {input[1]} --genome inputs/genomes.fna \
    #            --min {config[upstream_window_bp][0]} --max {config[upstream_window_bp][1]} -o {output}
    #       (add genome="inputs/genomes.fna" to input: when you wire the real version)

rule t14_negative_set:
    input: ANNOTATIONS, "results/upstream_regions.fasta"
    output: "results/negatives.fasta"
    shell: "echo '[T14] four-class negatives incl. SRS (mock)' && touch {output}"
    # real: python scripts/make_negatives.py --annotations {input[0]} --promoters {input[1]} \
    #            --classes cds,intergenic,downstream,srs --srs-shuffle dinucleotide -o {output}

rule t15_cdhit_splits:
    input: REFDB, TSS_CALLS, "results/upstream_regions.fasta", "results/negatives.fasta"
    output:
        "results/splits/train.parquet",
        "results/splits/val.parquet",
        "results/splits/test.parquet",
    threads: 8
    shell: "echo '[T15] CD-HIT clustering + cluster-aware splits (mock)' && touch {output}"
    # real: python scripts/make_splits.py --identity {config[cdhit_identity]} --threads {threads} \
    #            --positives {input[2]} --negatives {input[3]} --refdb {input[0]} --tss {input[1]} \
    #            --train {output[0]} --val {output[1]} --test {output[2]}

rule t16_tokenisation:
    input: "results/splits/train.parquet", "results/splits/val.parquet"
    output:
        "results/tokenized/prokbert.parquet",
        "results/tokenized/nt.parquet",
        "results/tokenized/cnn.npz",
    shell: "echo '[T16] per-model tokenisation (mock)' && touch {output}"
    # real: python scripts/tokenize.py --train {input[0]} --val {input[1]} \
    #            --prokbert {output[0]} --nt {output[1]} --cnn {output[2]}


# ---------------------------------------------------------------------
# Phase C — Model training  (GPU, except the recipe)
# ---------------------------------------------------------------------
rule t17_finetune_recipe:
    output: "results/finetune_recipe.yaml"
    shell: "echo '[T17] finalise fine-tuning recipe (mock)' && touch {output}"
    # real: decision task — hand-author results/finetune_recipe.yaml (or generate it):
    #       python scripts/build_recipe.py --base nucleotide-transformer-v2-250m-multispecies -o {output}

rule t18_prokbert_finetune:
    input: "results/tokenized/prokbert.parquet", "results/finetune_recipe.yaml"
    output: "results/models/prokbert/model.safetensors"
    resources: slurm_extra=GPU_EXTRA, runtime=480, mem_mb=32000
    log: "logs/t18.log"
    shell: "echo '[T18] ProkBERT-mini-long fine-tune (mock GPU)' && touch {output}"
    # real: python train_prokbert.py --data {input[0]} --recipe {input[1]} --out {output} 2> {log}
    #       (train_prokbert.py traps SIGUSR1 -> checkpoint, for preempt resume)

rule t19_nt_lora_finetune:
    input: "results/tokenized/nt.parquet", "results/finetune_recipe.yaml"
    output: "results/models/nt_lora/adapter.safetensors"
    resources: slurm_extra=GPU_EXTRA, runtime=480, mem_mb=32000
    log: "logs/t19.log"
    shell: "echo '[T19] NT v2 250M LoRA fine-tune (mock GPU)' && touch {output}"
    # real: python train_nt_lora.py --data {input[0]} --recipe {input[1]} --out {output} 2> {log}

rule t20_cnn_train:
    input: "results/tokenized/cnn.npz", "results/finetune_recipe.yaml"
