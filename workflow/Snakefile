    input: LIT_PROM, "results/T21.done"
    output: "results/T24.done"
    resources: slurm_extra=GPU_EXTRA, runtime=240
    shell:
        "python {REPO}/pipeline/evaluation/external-holdout/evaluate_external_template.py && touch {output}"
