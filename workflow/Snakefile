# =====================================================================
# Promoter Mining — legacy cluster scaffold (Task T3).
#
# Rules mix real commands, obsolete paths/templates and a recipe sentinel (T17).
# Phase-A inputs come from local_prep.smk (+ optional tss_prep.smk for T10).
#
# This is the legacy DAG, not the complete modern deployment workflow. Its default target still
# reaches outdated template paths and optional TSSpredator dependencies. New standalone scripts
# exist, but their existence does not repair the corresponding old rule wiring.
# Use local_prep.smk for acquisition, explicit T11-T14 outputs for dataset staging, and the maintained
# training/evaluation/mining recipes in docs/PIPELINE.md. A dry run checks wiring, not execution.
# Many rules declare only a `results/<task>.done` sentinel, not their real artifacts;
# a sentinel's existence does not establish that the intended outputs remain valid.
# T11-T14 instead declare their real .tsv outputs.
#
# Run:
#     snakemake -n results/T14/negative_set.tsv                      # needs configured Bakta inputs, not Phase A
#     snakemake --cores 4 results/T14/negative_set.tsv                # execute T11-T14 on this host
#     snakemake -s local_prep.smk --cores 4                          # required before T15 splitting
# T11-T14 and annotation staging are localrules even with the Slurm profile.
# Run substantial CPU work on a site-approved host/allocation. For T15_xs and
# deployment training/mining, use docs/PIPELINE.md rather than the default target.
# =====================================================================

import os

configfile: "config/config.yaml"

# Repo root, resolved from the Snakefile location (portable local <-> the cluster).
REPO = os.path.abspath(os.path.join(workflow.basedir, ".."))

# T6 Bakta outputs. config[bakta_dir] is either a .zip or an already-extracted dir.
# Normalise to BAKTA = the root dir that directly contains the <genome>_genomic_output/ subdirs.
BAKTA_SRC = config["bakta_dir"]
if not os.path.isabs(BAKTA_SRC):
    BAKTA_SRC = os.path.join(REPO, BAKTA_SRC)  # repo-relative -> absolute (portable across clone locations)
if str(BAKTA_SRC).endswith(".zip"):
    BAKTA = "results/bakta/all_bakta_output"   # produced by rule extract_bakta
else:
    BAKTA = BAKTA_SRC                          # already-extracted dir (external input)

# GPU jobs add per-GPU billing on top of the profile's preempt hygiene.
GPU_EXTRA = "'--gpus-per-node=1 --requeue --signal=B:USR1@120'"

# ---- Phase A starting state (produced by local_prep.smk / tss_prep.smk, pre-staged) ----
REFDB         = "inputs/reference_promoters.parquet"      # T8  — RegulonDB (+DBTBS) normalised
LIT_PROM      = "inputs/literature_promoters.tsv"         # T9  — curated synthetic promoters
TSS_CALLS     = "inputs/tss_sites.gff3"                   # T10 — TSSpredator empirical TSS (the cluster)
PUBLISHED_TSS = "inputs/published_tss_promoters.parquet"  # T7b — in-genus published TSS positives -> T15
LIT_TRAIN     = "inputs/literature_promoters_train.parquet"  # T9-split (option b) — in-genus training positives -> T15

# The only true graph leaves (evaluation reports + final deliverable).
LEAVES = ["T23", "T24", "T25", "T32"]


rule all:
    input:
        expand("results/{t}.done", t=LEAVES),


# GPU-heavy tasks submit as SLURM jobs; everything listed here runs on the login/submit node.
localrules: all, extract_bakta, collect_bakta_tsv, pt2_ship_to_huggingface, pt3_metrics_cv_stack, pt4_calibration_fdr_harness, pt6_validate_lock_schema, t11_housekeeping_set, t12_operon_detection, t13_upstream_extraction, t14_negative_set, t15_cdhit_splits, t16_tokenisation, t17_finetune_recipe, t22_metrics_suite, t25_sigma_stratified, t26_calibration, t27_empirical_fdr, t29_ensemble_aggregation, t30_peak_calling, t31_motif_annotation, t32_final_output

# ---------------------------------------------------------------------
# Pre-tasks (learning + reusable code)
# ---------------------------------------------------------------------
rule pt1_finetune_loop:
    output: "results/PT1.done"
    resources: slurm_extra=GPU_EXTRA, runtime=240
    shell:
        "python {REPO}/archive/prototypes/prokbert-finetune/prokbert_finetune.py && touch {output}"
    # GPU. Confirm torch.cuda.is_available(); PT1 reportedly ran on CPU (~6h) before — verify.

rule pt2_ship_to_huggingface:
    input: "results/PT1.done"
    output: "results/PT2.done"
    shell:
        "python {REPO}/archive/prototypes/PT2/push_to_hub.py && touch {output}"
    # Obsolete missing PT2 path. Standalone release packaging is in release/huggingface/upload_to_hf.py;
    # that uploader is not wired into this rule and requires checkpoint paths and authorised Hub access.

rule pt3_metrics_cv_stack:
    output: "results/PT3.done"
    shell:
        "python {REPO}/archive/prototypes/metrics-and-cv/metrics_cv.py && touch {output}"
    # LIVE (no args; writes results/pt3_metrics/pt3_cv_results.csv). Needs scikit-learn.

rule pt4_calibration_fdr_harness:
    input: "results/PT3.done"
    output: "results/PT4.done"
    shell:
        "python {REPO}/archive/prototypes/calibration-fdr/calibration_fdr.py && touch {output}"
    # Prototype demonstration on dummy data, not the deployed calibration/FDR pipeline.

rule pt5_sliding_window_ecoli:
    output: "results/PT5.done"
    resources: slurm_extra=GPU_EXTRA, runtime=240
    shell:
        # MG1655.fna path is cwd-relative -> run from the PT5 dir; capture the sentinel path first.
        "OUT=$(pwd)/{output} && cd {REPO}/archive/prototypes/ecoli-sliding-window && "
        "python sliding_window_inference.py && touch $OUT"
    # GPU. Writes mg1655_promoter_scores.csv (reused by T28/PT6).

rule pt6_validate_lock_schema:
    input: "results/PT5.done"
    output: "results/PT6.done"
    shell:
        "python {REPO}/archive/prototypes/pipeline-validation/validate_promoters.py "
        "--pred {REPO}/archive/prototypes/ecoli-sliding-window/mg1655_promoter_scores.csv "
        "--regulondb {REPO}/archive/prototypes/pipeline-validation/regulondb_tss.tsv "
        "--genome {REPO}/archive/prototypes/ecoli-sliding-window/MG1655.fna --outdir results/PT6 && touch {output}"
    # LIVE once a RegulonDB E. coli TSS table is staged at PT6/regulondb_tss.tsv. Locks the T32 schema.


# ---------------------------------------------------------------------
# Phase B — Dataset construction  (LIVE: reads Bakta from BAKTA = config[bakta_dir])
# ---------------------------------------------------------------------
rule extract_bakta:
    # the cluster ships Bakta as a zip whose top folder is all_bakta_output/. Only runs when
    # config[bakta_dir] is a .zip; with an extracted dir, BAKTA points straight at it.
    input: BAKTA_SRC
    output: directory("results/bakta/all_bakta_output")
    shell:
        "rm -rf results/bakta && mkdir -p results/bakta && "
        "unzip -q -o {input} -x '__MACOSX/*' -d results/bakta && "
        "test -d {output}"

rule collect_bakta_tsv:
    # T11 wants a FLAT dir of Bakta *.tsv; symlink them flat with ABSOLUTE targets.
    input: BAKTA
    output: directory("results/bakta_tsv")
    shell:
        r"""
        mkdir -p {output}
        root=$(cd "{input}" && pwd)
        for d in "$root"/*_genomic_output; do
          s=$(basename "$d" _output)
          ln -sf "$d/$s.tsv" "{output}/$s.tsv"
        done
        """

rule t11_housekeeping_set:
    input: "results/bakta_tsv"
    output: "results/T11/housekeeping_genes.tsv"
    shell:
        "python {REPO}/pipeline/datasets/housekeeping-genes/define_housekeeping.py "
        "--tsv-dir {input} --out-dir results/T11"

rule t12_operon_detection:
    input:
        hk="results/T11/housekeeping_genes.tsv",
        bakta=BAKTA,
    output: "results/T12/operon_leaders.tsv"
    shell:
        "python {REPO}/pipeline/datasets/operon-detection/operon_detection.py "
        "--hk-tsv {input.hk} --bakta-dir {input.bakta} --out-tsv {output} "
        "--max-dist {config[operon_max_dist_bp]} --window {config[upstream_window_bp]}"

rule t13_upstream_extraction:
    input:
        leaders="results/T12/operon_leaders.tsv",
        bakta=BAKTA,
    output: "results/T13/upstream_regions.tsv"           # POSITIVE windows (NB: inferred positives)
    shell:
        "python {REPO}/pipeline/datasets/upstream-extraction/upstream_extraction.py "
        "--leaders-tsv {input.leaders} --bakta-dir {input.bakta} --out-tsv {output} "
        "--window {config[upstream_window_bp]}"

rule t14_negative_set:
    input:
        upstream="results/T13/upstream_regions.tsv",
        bakta=BAKTA,
    output: "results/T14/negative_set.tsv"               # four-class negatives incl. SRS (seeded)
    shell:
        "python {REPO}/pipeline/datasets/negative-sets/negative_set_generation.py "
        "--upstream-tsv {input.upstream} --bakta-dir {input.bakta} --out-tsv {output} "
        "--window {config[upstream_window_bp]} --seed {config[random_seed]}"

rule t15_cdhit_splits:
    input:
        refdb=REFDB,                                     # T8 cross-species positives
        published=PUBLISHED_TSS,                         # T7b in-genus published-TSS positives
        t9_train=LIT_TRAIN,                              # T9-split (option b) in-genus C. acetobutylicum positives
        tss=TSS_CALLS,                                   # legacy dependency only: not passed to --positives
        positives="results/T13/upstream_regions.tsv",    # T13 inferred positives
        negatives="results/T14/negative_set.tsv",        # T14 negatives
    output: "results/T15.done"
    shell:
        "python {REPO}/pipeline/datasets/clustering-and-splits/cdhit_splits.py "
        "--positives {input.refdb} {input.published} {input.t9_train} {input.positives} "
        "--negatives {input.negatives} --identity {config[cdhit_identity]} "
        "--seed {config[random_seed]} --out results/T15/ && touch {output}"
    # cdhit_splits.py exists: schema harmonisation, re-windowing, seeded negative sampling,
    # source/cluster train pinning and MMseqs2/CD-HIT dispatch are implemented there.
    # This legacy rule builds plain T15, not deployed T15_xs, and unnecessarily requires T10.
    # Use the explicit xs-source command in docs/PIPELINE.md; T10 is not a deployed positive source.

rule t16_tokenisation:
    input: "results/T15.done"
    output: "results/T16.done"
    shell:
        "python {REPO}/pipeline/datasets/tokenisation/tokenise.py results/T15/ results/T16/ && touch {output}"
    # tokenise.py exists and writes model-specific encodings/metadata. This rule targets plain T16,
    # not the deployed T16_xs paths used by the standalone training recipes.


