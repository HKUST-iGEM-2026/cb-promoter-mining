    # Use evaluate_external_holdout.py with explicit model paths; this rule is not migrated.
    # If T9 training is enabled, evaluate only its held-out rows rather than the complete T9 library.

rule t25_sigma_stratified:
    input: TSS_CALLS, "results/T22.done"
    output: "results/T25.done"
    shell:
        "python {REPO}/pipeline/evaluation/sigma-factor-stratified/sigma_stratified.py {input} results/T25/ && touch {output}"
