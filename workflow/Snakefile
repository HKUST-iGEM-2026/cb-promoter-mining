    # arguments. Its historical split/prediction analysis is not T10-derived deployed-ensemble evidence.

rule t26_calibration:
    input: "results/PT4.done", LIT_PROM, "results/T22.done"
    output: "results/T26.done"
    shell:
        "python {REPO}/pipeline/evaluation/calibration/calibrate.py {input} results/T26/ && touch {output}"
    # Missing legacy calibrate.py path. Available checkpoint-specific Platt/AT helpers and
    # run_calibration_xs.sh are standalone; the ordinary deployed mine does not use calibrators.

rule t27_empirical_fdr:
    input: "results/PT4.done", "results/T14/negative_set.tsv", "results/T26.done"
    output: "results/T27.done"
    shell:
        "python {REPO}/pipeline/evaluation/empirical-fdr/empirical_fdr.py {input} results/T27/ && touch {output}"
    # Missing legacy empirical_fdr.py path. Standalone run_fdr_mine.sbatch/fdr_stats.py use
    # convergent-intergenic putative nulls and pooled candidate+null ranks, not T14 SRS.
    # Selected-peak p/q are conditional screening statistics, not established biological FDR.


