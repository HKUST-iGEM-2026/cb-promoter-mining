    resources: slurm_extra=GPU_EXTRA, runtime=480
    shell:
        "python {REPO}/pipeline/mining/genome-scan/sliding_window_engine_template.py && touch {output}"
    # Missing legacy scanner-template path. Deployment uses mine_3model.sbatch plus
    # genome_inference.py/evo2_scan_restricted.py with explicit assembly/checkpoint/grid inputs.

rule t29_ensemble_aggregation:
    input: "results/T28.done"
    output: "results/T29.done"
    shell:
        "python {REPO}/pipeline/mining/ensemble-aggregation/ensemble.py results/T28/ results/T29/ && touch {output}"
    # Missing legacy ensemble.py path. Standalone align_tracks.py + ensemble_rank_percentile.py
    # intersect member grids and average rank percentiles; this rule is not migrated.

rule t30_peak_calling:
    input: "results/T29.done"
    output: "results/T30.done"
    shell:
        "python {REPO}/pipeline/mining/peak-calling/peak_calling.py results/T29/ results/T30/ && touch {output}"
    # Missing legacy peak_calling.py path. Standalone call_peaks.py merges score-gated windows;
    # extract_call_sequences.py subsequently writes oriented summit FASTA/candidate ids.

rule t31_motif_annotation:
    input: "results/T30.done"
    output: "results/T31.done"
    shell:
        # Legacy MEME/FIMO commands; no environment activation or transcription-strand-only FIMO flag.
        # The deployed standalone annotate_motifs.sh uses oriented summit sequences and --norc.
        "meme results/T30/candidates.fasta -oc results/T31/meme -dna -mod zoops -nmotifs 5 -minw 6 -maxw 35 && "
        "fimo --oc results/T31/fimo results/T31/meme/meme.txt results/T30/candidates.fasta && touch {output}"
    # Motif discovery/position labels do not establish sigma usage, activity or constitutive regulation.
    # This legacy input/output contract differs from the maintained standalone T31/T32 workflow.

rule t32_final_output:
    input: "results/T26.done", "results/T27.done", "results/T30.done", "results/T31.done"
    output: "results/T32.done"
    shell:
        "python {REPO}/pipeline/mining/candidate-table/assemble_final.py "
        "results/T26/ results/T27/ results/T30/ results/T31/ results/T32/ && touch {output}"
    # Missing legacy assemble_final.py path. Standalone build_candidate_table.py, q joining and
    # prioritize_candidates.py are documented in docs/PIPELINE.md; sequence/spreadsheet exports
    # remain a separately supplied enrichment step, not implemented by this rule.
