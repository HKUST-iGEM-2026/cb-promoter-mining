rule t17_finetune_recipe:
    input: "results/PT2.done"
    output: "results/T17.done"
    shell:
        "mkdir -p results/T17 && touch {output}"
    # DECISION GATE, not a command: finalise the fine-tuning recipe (a config) from PT2 -> T18/T19/T20.

rule t18_prokbert_finetune:
    input: "results/T16.done", "results/T17.done"
    output: "results/T18.done"
    resources: slurm_extra=GPU_EXTRA, runtime=480
    shell:
        "python {REPO}/pipeline/training/prokbert/train_prokbert.py && touch {output}"
    # train_prokbert.py exists; this no-argument rule uses plain T16/default settings and inherits
    # obsolete PT2/T17 dependencies. Deployment T21_xs training is specified in docs/PIPELINE.md.

rule t19_nt_lora_finetune:
    input: "results/T16.done", "results/T17.done"
    output: "results/T19.done"
    resources: slurm_extra=GPU_EXTRA, runtime=480
    shell:
        "python {REPO}/pipeline/training/nucleotide-transformer/train_nt_lora.py && touch {output}"
    # train_nt_lora.py exists; use the separate ENV_NT runtime. This historical model is not deployed;
    # the rule does not activate that environment and still inherits obsolete PT2/T17 dependencies.

rule t20_cnn_train:
    input: "results/T16.done", "results/T17.done"
    output: "results/T20.done"
    resources: slurm_extra=GPU_EXTRA, runtime=480
    shell:
        "python {REPO}/pipeline/training/cnn/train_cnn_template.py && touch {output}"
    # Legacy 300bp template with cwd-relative data/* inputs and an unseeded final random_split.
    # Current standalone trainers are train_cnn.py and deployed train_cnn_v2.py; neither is wired here.

rule t21_hparam_sweep:
    input: "results/T18.done", "results/T19.done", "results/T20.done"
    output: "results/T21.done"
    resources: slurm_extra=GPU_EXTRA, runtime=720
    shell:
        "python {REPO}/pipeline/training/hyperparameter-sweep/hyperparameter_sweep.py && touch {output}"
    # Standalone Optuna orchestrator exists and selects on validation AP. This rule retains
    # historical defaults/dependencies; it does not create deployed T21_xs checkpoints.


